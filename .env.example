# Eye-Catch local configuration example
# Copy this file to `.env` and edit values for your machine.

# Database
DB_HOST=localhost
DB_NAME=eyecatch_db
DB_USER=postgres
DB_PASSWORD=
DB_PORT=5432

# Cataract model
# v4 backbone comparison winner (train_ai_v4.py): EfficientNet-B0.
# MODEL_PATH and MODEL_BACKBONE must match (resnet18 | efficientnet_b0).
# Weights (.pth) are not in git — get them from a teammate or retrain.
MODEL_PATH=cataract_efficientnet_b0_v4.pth
MODEL_BACKBONE=efficientnet_b0

# Runtime thresholds
# Cataract risk threshold in percent. Keep this in sync with training/evaluation reports.
RISK_THRESHOLD=50.0
# Lower bound of the "borderline" band, in percent. Probabilities in
# [BORDERLINE_THRESHOLD, RISK_THRESHOLD) are reported as "borderline — retake/see a doctor"
# instead of "normal". Must satisfy 0 < BORDERLINE_THRESHOLD < RISK_THRESHOLD.
BORDERLINE_THRESHOLD=25.0
# Lower bound of the "uncertain — retake a close-up" band.
# Must satisfy 0 <= UNCERTAIN_THRESHOLD < BORDERLINE_THRESHOLD.
UNCERTAIN_THRESHOLD=2.0
# Minimum MTCNN face confidence used before cropping eyes from a face photo.
FACE_PROB_THRESHOLD=0.95
# Cosine similarity threshold for the eye/non-eye validator.
EYE_SIM_THRESHOLD=0.62

# Upload limits
MAX_UPLOAD_SIZE_BYTES=10485760
# 동시에 실행할 무거운 작업 수. GPU/CPU가 작은 PC에서는 기본값을 유지하세요.
MAX_INFERENCE_CONCURRENCY=1
MAX_LLM_CONCURRENCY=2

# CORS — comma-separated list of external origins allowed to call this API.
# Leave EMPTY (the default) unless the frontend is hosted on a different domain:
# the bundled frontend is served from this same server (/static), so requests are
# same-origin and need no CORS headers. ngrok sharing is same-origin too.
# Example: ALLOWED_ORIGINS=http://localhost:8000,https://myapp.example.com
ALLOWED_ORIGINS=

# Ollama / Gemma
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=gemma4:e2b-it-qat
OLLAMA_TIMEOUT_SECONDS=120

# Optional: Kakao Local REST API key for Korean clinic search.
KAKAO_REST_KEY=

# Horizontal-flip TTA at inference. OFF for the v6 weights (it added FN/FP in re-measurement).
USE_TTA=false
